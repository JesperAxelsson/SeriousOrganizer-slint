import {
    Button,
    VerticalBox,
    ListView,
    HorizontalBox,
    LineEdit,
    StandardTableView,
} from "std-widgets.slint";

struct Rect {
    text: string,
    color: color,
    bg: color,
}

struct EntryModel {
    name: string,
    path: string,
    size: string,
}

struct FileModel {
    name: string,
    path: string,
    size: string,
}

component EntryListView inherits StandardTableView {
    in-out property <[[StandardListViewItem]]> items: [];

    width: 100%;
    height: 100%;

    columns: [
        { title: "Name" },
        { title: "Path" },
        { title: "Size", width: 80px, horizontal-stretch: 0 }
    ];
    rows: items;
}

component FileListView {
    in-out property <[[StandardListViewItem]]> items: [];

    StandardTableView {
        width: 100%;
        height: 100%;
        columns: [{ title: "Name" }, { title: "Path" }, { title: "Size", width: 80px }];
        rows: items;
    }
}

export component AppWindow inherits Window {
    in-out property <string> search-text;
    in-out property <[[StandardListViewItem]]> items: [];
    in-out property <[[StandardListViewItem]]> file-items: [];

    callback reload();
    callback reload-done();
    callback search-text-changed(string);
    callback entry-changed(int);

    VerticalBox {
        HorizontalBox {
            // Text {
            //     text: "Search";
            // }

            LineEdit {
                // text: search-text;
                placeholder-text: "Search";

                edited(text) => {
                    root.search-text-changed(text);
                }
            }

            Button {
                text: "Reload";
                clicked => {
                    root.reload();
                }
            }
        }

        EntryListView {
            items: items;

            current-row-changed(current-row) => {
                root.entry-changed(current-row);
            }
        }

        FileListView {
            items: file-items;
        }
    }
}
