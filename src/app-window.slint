import {
    Button,
    VerticalBox,
    ListView,
    HorizontalBox,
    LineEdit,
    StandardTableView,
    StandardListView,
} from "std-widgets.slint";
    import { AppState } from "state.slint";
import { ContextMenu } from "components/context-menu.slint";
import { TabButton } from "components/tab-button.slint";
import { LocationData, TableRow } from "types.slint";
import { LibraryView } from "views/library-view.slint";
import { LocationsView } from "views/locations-view.slint";
import { RenameDialog } from "components/rename-dialog.slint";
import { ConfirmDialog } from "components/confirm-dialog.slint";

// Re-exports
export { LocationData, TableRow } from "types.slint";
    export { AppState } from "state.slint";

export component AppWindow inherits Window {
    // Tab handling
    property <int> active-tab: 0;

    // Context menu
    property <length> menu-x;
    property <length> menu-y;
    callback context-command(string);
    callback rename-confirmed(string);

    // List actions
    callback entry-context-opened(int);
    callback file-context-opened(int);
     
    // Locations
    callback add_location();
    callback remove_location(int);
    in property <[LocationData]> locations;

    // Confirm dialog
    in-out property <int> confirm-request;
    callback confirm-answered(bool, int); // anser, request id

    public function open-confirm(title: string, message: string, confirm-text: string, show-cancel: bool, request: int) {
        root.confirm-request = request;
        confirm-dialog.show-dialog(title, message, confirm-text, show-cancel);
    }

    public function open-rename-dialog(current-name: string) {
        rename-dialog.show-dialog(current-name);
    }


    VerticalBox {
        padding: 5px;
        padding-left: 20px;
                    // spacing: 20px;

        // --- TAB BAR ---
        Rectangle {
            height: 45px;
            // background: #f5f5f5;

            HorizontalLayout {
                spacing: 20px;
                TabButton {
                    text: "Library";
                    active: root.active-tab == 0;
                    clicked => {
                        root.active-tab = 0;
                    }
                }

                TabButton {
                    text: "Locations Settings";
                    active: root.active-tab == 1;
                    clicked => {
                        root.active-tab = 1;
                    }
                }

                // Take up remaining space
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                y: parent.height - self.height;
                background: #dddddd;
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 0: LibraryView {
            entry-context-requested(row, x, y) => {
                root.entry-context-opened(row);
                root.menu-x = x;
                root.menu-y = y;
                context-menu.show();
            }
            file-context-requested(row, x, y) => {
                root.file-context-opened(row);
                root.menu-x = x;
                root.menu-y = y;
                context-menu.show();
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 1: LocationsView {
            locations: root.locations;
            add-location => {
                root.add_location();
            }
            remove-location(id) => {
                root.remove_location(id);
            }
        }
    }

    confirm-dialog := ConfirmDialog {
        visible: false;
        width: 100%;
        height: 100%;

        accepted => {
            self.visible = false;
            root.confirm-answered(true, root.confirm-request);
        }

        cancelled => {
            self.visible = false;
            root.confirm-answered(false, root.confirm-request);
        }
    }

    rename-dialog := RenameDialog {
        visible: false;
        // width: 100%;
        // height: 100%;

        accepted(new-name) => {
            self.visible = false;
            root.rename-confirmed(new-name);
        }
        cancelled => {
            self.visible = false;
        }
    }

    context-menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        entries <=> AppState.menu-entries;
        context-command(command) => {
            root.context-command(command);
        }
    }
}
