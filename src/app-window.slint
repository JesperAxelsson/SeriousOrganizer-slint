import {
    Button,
    VerticalBox,
    ListView,
    HorizontalBox,
    LineEdit,
    StandardTableView,
} from "std-widgets.slint";

export struct LocationData {
    id: int,
    name: string,
    path: string,
    size_str: string,
}
    

component EntryListView inherits StandardTableView {
    in-out property <int> current-entry;
    in-out property <[[StandardListViewItem]]> items: [];

    width: 100%;
    height: 50%;

    current-row <=> root.current-entry;
    columns: [
        { title: "Name" },
        { title: "Path" },
        { title: "Size", width: 80px, horizontal-stretch: 0 }
    ];
    rows: root.items;
}

component FileListView inherits StandardTableView {
    in-out property <[[StandardListViewItem]]> items: [];

    width: 100%;
    height: 50%;

    columns: [{ title: "Name" }, { title: "Path" }, { title: "Size", width: 80px }];
    rows: items;
}

component ContextMenu inherits PopupWindow {
    width: 150px;
    close-policy: PopupClosePolicy.close-on-click-outside;

    callback context-command(string);

    Rectangle {
        background: white;
        border-color: lightgray;
        border-width: 1px;
        drop-shadow-blur: 5px;
        drop-shadow-color: #00000033;

        VerticalLayout {
            padding: 4px;

            Rectangle {
                height: 30px;
                background: touch-open.has-hover ? #eeeeee : transparent;
                Text {
                    text: "Open file";
                    x: 10px;
                    vertical-alignment: center;
                }

                touch-open := TouchArea {
                    clicked => {
                        root.context-command("file-open");
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // Search bar
    in-out property <string> search-text;
    callback reload();
    callback reload-done();
    callback search-text-changed(string);

    // Tab handling
    property <int> active-tab: 0;

    // Context menu
    property <length> menu-x;
    property <length> menu-y;
    callback context-command(string);

    // List actions
    in-out property <int> current-entry;
    in-out property <[[StandardListViewItem]]> items: [];
    in-out property <[[StandardListViewItem]]> file-items: [];
    callback entry-changed(int);

    // Locations
    callback add_location();
    callback remove_location(int);
    in property <[LocationData]> locations;

    context-menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        context-command(command) => {
            root.context-command(command);
        }
    }

    VerticalBox {
        // --- TAB BAR ---
        HorizontalBox {
            height: 5%;

            Button {
                text: "Library";
                clicked => {
                    root.active-tab = 0;
                }
            }

            Button {
                text: "Locations Settings";
                clicked => {
                    root.active-tab = 1;
                }
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 0: VerticalBox {
            VerticalBox {
                HorizontalBox {
                    LineEdit {
                        placeholder-text: "Search";

                        edited(text) => {
                            root.search-text-changed(text);
                        }
                    }

                    Button {
                        text: "Reload";
                        clicked => {
                            root.reload();
                        }
                    }

                    Button {
                        text: "Locations";
                        clicked => {
                            root.reload();
                        }
                    }
                }

                EntryListView {
                    current-entry <=> current-entry;
                    items: items;

                    changed current-entry => {
                        root.entry-changed(root.current-entry);
                    }

                    row-pointer-event(row, event, position) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    // root.menu-x = event.absolute-position.x;
                    // root.menu-y = event.absolute-position.y;
                    
                    root.menu-x = self.absolute-position.x + position.x;
                            root.menu-y = self.absolute-position.y + position.y;

                            context-menu.show();
                        }
                    }
                }

                FileListView {
                    items: file-items;
                }
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 1: VerticalBox {
            VerticalBox {
                Text {
                    text: "Settings";
                }

                Button {
                    text: "Add Location";
                    clicked => {
                        root.add_location();
                    }
                }

                ListView {
                    for loc in root.locations: HorizontalBox {
                        Text {
                            text: loc.name;
                        }

                        Text {
                            text: loc.path;
                        }

                        Text {
                            text: loc.size_str;
                        }

                        Button {
                            text: "Remove";
                            clicked => {
                                remove_location(loc.id)
                            }
                        }
                    }
                }
            }
        }
    }
}
