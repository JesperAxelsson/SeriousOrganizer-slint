import {
    Button,
    VerticalBox,
    ListView,
    HorizontalBox,
    LineEdit,
    StandardTableView,
    StandardListView,
} from "std-widgets.slint";
import { ContextMenu } from "components/context-menu.slint";

export struct LocationData {
    id: int,
    name: string,
    path: string,
    size_str: string,
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked <=> touch.clicked;

    Text {
        text: root.text;
        color: root.active ? #2196F3 : #666666;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        width: parent.width;
        height: 3px;
        y: parent.height - self.height; // Align to bottom
        background: root.active ? #2193F3 : transparent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

component EntryListView inherits StandardTableView {
    in-out property <int> current-entry;
    in-out property <[[StandardListViewItem]]> items: [];

    width: 100%;
    height: 50%;

    current-row <=> root.current-entry;
    columns: [
        { title: "Name" },
        { title: "Path" },
        { title: "Size", width: 80px, horizontal-stretch: 0 }
    ];
    rows: root.items;
}

component FileListView inherits StandardTableView {
    in-out property <[[StandardListViewItem]]> items: [];

    width: 100%;
    height: 50%;

    columns: [{ title: "Name" }, { title: "Path" }, { title: "Size", width: 80px }];
    rows: items;
}


export component AppWindow inherits Window {
    // Search bar
    in-out property <string> search-text;
    callback reload();
    callback reload-done();
    callback search-text-changed(string);

    // Tab handling
    property <int> active-tab: 0;

    // Context menu
    property <length> menu-x;
    property <length> menu-y;
    callback context-command(string);

    // List actions
    in-out property <int> current-entry;
    in-out property <[[StandardListViewItem]]> items: [];
    in-out property <[[StandardListViewItem]]> file-items: [];
    callback entry-changed(int);

    // Locations
    callback add_location();
    callback remove_location(int);
    in property <[LocationData]> locations;

    context-menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        context-command(command) => {
            root.context-command(command);
        }
    }

    VerticalBox {
        padding: 5px;
        padding-left: 20px;
                    // spacing: 20px;

        // --- TAB BAR ---
        Rectangle {
            height: 45px;
            // background: #f5f5f5;

            HorizontalLayout {
                    spacing: 20px;
                TabButton {
                    text: "Library";
                    active: root.active-tab == 0;
                    clicked => {
                        root.active-tab = 0;
                    }
                }

                TabButton {
                    text: "Locations Settings";
                    active: root.active-tab == 1;
                    clicked => {
                        root.active-tab = 1;
                    }
                }

                // Take up remaining space
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                y: parent.height - self.height;
                background: #dddddd;
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 0: VerticalBox {
            VerticalBox {
                HorizontalBox {
                    LineEdit {
                        placeholder-text: "Search";

                        edited(text) => {
                            root.search-text-changed(text);
                        }
                    }

                    Button {
                        text: "Reload";
                        clicked => {
                            root.reload();
                        }
                    }
                }

                EntryListView {
                    current-entry <=> current-entry;
                    items: items;

                    changed current-entry => {
                        root.entry-changed(root.current-entry);
                    }

                    row-pointer-event(row, event, position) => {
                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    // root.menu-x = event.absolute-position.x;
                    // root.menu-y = event.absolute-position.y;
                    
                    root.menu-x = self.absolute-position.x + position.x;
                            root.menu-y = self.absolute-position.y + position.y;

                            context-menu.show();
                        }
                    }
                }

                FileListView {
                    items: file-items;
                }
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 1: VerticalBox {
            padding: 16px;
            spacing: 16px;

            Text {
                text: "Settings";
            }

            HorizontalBox {
                alignment: start;
                Text {
                    text: "Managed Locations";
                    font-size: 16px;
                    vertical-alignment: center;
                }

                Button {
                    text: "Add New Folder";
                    clicked => {
                        root.add_location();
                    }
                }
            }

            // StandardListView {
            //     model: root.locations;
            // }
            
            ListView {
                for loc in root.locations: HorizontalBox {
                    Text {
                        text: loc.name;
                    }

                    Text {
                        text: loc.path;
                    }

                    Text {
                        text: loc.size_str;
                    }

                    Button {
                        text: "Remove";
                        clicked => {
                            remove_location(loc.id)
                        }
                    }
                }
            }
        }
    }
}
