import {
    Button,
    VerticalBox,
    ListView,
    HorizontalBox,
    LineEdit,
    StandardTableView,
    StandardListView,
} from "std-widgets.slint";
import { ContextMenu } from "components/context-menu.slint";
import { TabButton } from "components/tab-button.slint";
import { LocationData, TableRow } from "types.slint";
import { EntryListView, FileListView } from "components/entry-tables.slint";
import { LibraryView } from "views/library-view.slint";
import { LocationsView } from "views/locations-view.slint";

// Re-exports
export { LocationData, TableRow } from "types.slint";

export component AppWindow inherits Window {
    // Search bar
    in-out property <string> search-text;
    callback reload();
    callback reload-done();
    callback search-text-changed(string);

    // Tab handling
    property <int> active-tab: 0;

    // Context menu
    property <length> menu-x;
    property <length> menu-y;
    callback context-command(string);

    // List actions
    in-out property <int> current-entry;
    in-out property <[TableRow]> items: [];
    in-out property <[[StandardListViewItem]]> file-items: [];
    callback entry-activated(int);
    callback entry-changed(int);
    callback entry-clicked(int, bool, bool);
    callback entry-context-opened(int);

    // Locations
    callback add_location();
    callback remove_location(int);
    in property <[LocationData]> locations;

    context-menu := ContextMenu {
        x: root.menu-x;
        y: root.menu-y;
        context-command(command) => {
            root.context-command(command);
        }
    }

    VerticalBox {
        padding: 5px;
        padding-left: 20px;
                    // spacing: 20px;

        // --- TAB BAR ---
        Rectangle {
            height: 45px;
            // background: #f5f5f5;

            HorizontalLayout {
                spacing: 20px;
                TabButton {
                    text: "Library";
                    active: root.active-tab == 0;
                    clicked => {
                        root.active-tab = 0;
                    }
                }

                TabButton {
                    text: "Locations Settings";
                    active: root.active-tab == 1;
                    clicked => {
                        root.active-tab = 1;
                    }
                }

                // Take up remaining space
                Rectangle {
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                width: parent.width;
                height: 1px;
                y: parent.height - self.height;
                background: #dddddd;
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 0: LibraryView {
            current-entry <=> root.current-entry;
            items: root.items;
            file-items: root.file-items;

            reload => {
                root.reload();
            }
            search-text-changed(text) => {
                root.search-text-changed(text);
            }
            entry-changed(ix) => {
                root.entry-changed(ix);
            }
            entry-clicked(row, ctrl, shift) => {
                root.entry-clicked(row, ctrl, shift);
            }
            entry-activated(row) => {
                root.entry-activated(row);
            }
            entry-context-requested(row, x, y) => {
                root.entry-context-opened(row);
                root.menu-x = x;
                root.menu-y = y;
                context-menu.show();
            }
        }

        // --- VIEW 0: MAIN LIBRARY
        if root.active-tab == 1: LocationsView {
            locations: root.locations;
            add-location => { root.add_location(); }
            remove-location(id) => { root.remove_location(id); }
        }
    }
}
