import { Palette } from "std-widgets.slint";
import { MenuEntry } from "../types.slint";

component Option inherits Rectangle {
    height: 30px;
    background: touch-option.has-hover ? Palette.selection-background : transparent;

    in property <string> name;

    callback clicked();

    Text {
        text: root.name;
        x: 10px;
        vertical-alignment: center;
        color: touch-option.has-hover ? Palette.selection-foreground : Palette.foreground;
    }

    touch-option := TouchArea {

        clicked => {
            root.clicked();
        }
    }
}

export component ContextMenu inherits PopupWindow {
    width: 150px;
    close-policy: PopupClosePolicy.close-on-click-outside;

    in-out property <[MenuEntry]> entries;

    callback context-command(string);

    Rectangle {
        background: Palette.background;
        border-color: lightgray;
        border-width: 1px;
        drop-shadow-blur: 5px;
        drop-shadow-color: #00000033;

        VerticalLayout {
            padding: 4px;

            for entry in root.entries: Option {
                name: entry.label;
                clicked => {
                    root.context-command(entry.command);
                }
            }
        }
    }
}
