import { TableRow, MenuEntry, LabelData } from "types.slint";

export global AppState {
    // *** Entry ***
    in-out property <[TableRow]> items: [];

    in-out property <int> current-entry: -1;
    in-out property <int> entry-sort-column: -1;
    in-out property <bool> entry-sort-ascending: true;

    in-out property <[MenuEntry]> menu-entries: [];

    callback entry-changed(int);
    callback entry-clicked(int, bool, bool);
    callback entry-activated(int);
    callback entry-header-clicked(int);
    // // Absolute window coordinates of a right click on the entry table
    // callback entry-context-requested(int, length, length);

    // *** File ***
    in-out property <[TableRow]> file-items: [];

    in-out property <int> current-file: -1;
    in-out property <int> file-sort-column: -1;
    in-out property <bool> file-sort-ascending: true;

    callback file-changed(int);
    callback file-clicked(int, bool, bool);
    callback file-activated(int);
    callback file-header-clicked(int);
    // callback file-context-requested(int, length, length);

    // Search bar
    in-out property <string> search-text;
    callback reload();
    callback reload-done();
    callback search-text-changed(string);

    // Location
    in-out property <[TableRow]> locations: [];

    // Label
    in-out property <[LabelData]> labels;
    callback label-stepped(int, bool);
    callback label-add-requested(string);
    callback label-filters-reset();
    callback label-filters-exclude-all();
}
