import {
    Button,
    VerticalBox,
    HorizontalBox,
    ListView,
} from "std-widgets.slint";
import { DataTable } from "../components/data-table.slint";
import { AppState } from "../state.slint";

export component LocationsView inherits VerticalBox {
    callback add-location();
    callback context-requested(int, length, length);

    padding: 16px;
    spacing: 16px;

    Text {
        text: "Settings";
    }

    HorizontalBox {
        alignment: start;
        Text {
            text: "Managed Locations";
            font-size: 16px;
            vertical-alignment: center;
        }

        Button {
            text: "Add New Folder";
            clicked => {
                root.add-location();
            }
        }
    }

    DataTable {
        vertical-stretch: 1;

        rows: AppState.locations;

        selectable: false;
        sortable: false;

        context-requested(row, x, y) => {
            root.context-requested(row, x, y);
        }
    }
}
