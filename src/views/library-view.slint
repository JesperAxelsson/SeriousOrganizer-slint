import {
    VerticalBox,
    Button,
    LineEdit,
    HorizontalBox,
} from "std-widgets.slint";
import { FileListView, EntryListView } from "../components/entry-tables.slint";
import { TableRow } from "../types.slint";
import { DataTable } from "../components/data-table.slint";

export component LibraryView inherits VerticalBox {
    in-out property <int> current-entry;
    in property <[TableRow]> items;
    in property <[[StandardListViewItem]]> file-items;

    callback reload();
    callback search-text-changed(string);
    callback entry-changed(int);
    callback entry-clicked(int, bool, bool);
    callback entry-activated(int);
    // Absolute window coordinates of a right click on the entry table
    callback entry-context-requested(int, length, length);

    HorizontalBox {
        LineEdit {
            placeholder-text: "Search";

            edited(text) => {
                root.search-text-changed(text);
            }
        }

        Button {
            text: "Reload";
            clicked => {
                root.reload();
            }
        }
    }

    DataTable {
        height: 50%;
        current-row <=> root.current-entry;
        rows: root.items;

        changed current-row => {
            root.entry-changed(root.current-entry);
        }

        row-clicked(row, ctrl, shift) => {
            root.entry-clicked(row, ctrl, shift);
        }
        row-activated(row) => {
            root.entry-activated(row);
        }
        context-requested(row, x, y) => {
            root.entry-context-requested(row, x,y);
        }
    }

    FileListView {
        items: root.file-items;
    }
}
