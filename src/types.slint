
export enum FilterState { unset, include, exclude }

export struct LabelData {
    id: int,
    name: string,
    state: FilterState,
}

export enum AssignState { unassigned, partial, assigned }

export struct AssignRow {
    id: int,
    name: string,
    state: AssignState,
}

export struct TableRow {
    id: int,
    name: string,
    path: string,
    size_str: string,
    selected: bool,
}

export struct MenuEntry {
    command: string,
    label: string,
}
